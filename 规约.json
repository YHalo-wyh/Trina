  "verification_commands": {
    "V-CONTRACT": {
      "argv": ["{python}", "-X", "utf8", "-m", "scripts.verify_contract"],
      "purpose": "静态核对六类交付物、TR 需求、规则、实现路径和测试声明"
    },
    "V-COURSE": {
      "argv": ["{python}", "-X", "utf8", "-m", "scripts.verify_course_pack"],
      "purpose": "核对历史课程包的 REQ、场景、任务和证据追踪关系"
    },
    "V-TESTS": {
      "argv": ["{python}", "-X", "utf8", "-m", "unittest", "discover", "-s", "tests"],
      "purpose": "执行当前产品完整回归"
    },
    "V-DIFF": {
      "argv": ["git", "diff", "--check"],
      "purpose": "检查待提交差异的空白错误"
    }
  },
