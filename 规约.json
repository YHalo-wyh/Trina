      "id": "TR-04",
      "title": "单 Agent 逐步研究",
      "priority": "P0",
      "status": "implemented",
      "implementation": ["trina/brain/agent.py", "trina/brain/chat.py", "trina/brain/prompts.py", "trina/runtime_status.py", "trina/conversation.py", "trina/llm/openai_backend.py"],
      "verification": ["V-CONTRACT", "V-TESTS"],
      "rules": [
        {
          "id": "TR-04-R01",
          "level": "MUST",
          "statement": "任务 Agent、对话 Assistant 与通用 Worker 必须共用含七个模块的最高权限安全工程师系统提示词。",
          "tests": ["tests.test_brain.TestParseAction.test_system_messages_define_the_security_engineer_modules"]
        },
        {
          "id": "TR-04-R02",
          "level": "MUST",
          "statement": "动态工具、范围、事实与预算必须作为本轮运行数据传入，不得固化为陈旧 system 内容。",
          "tests": ["tests.test_brain.TestReActLoop.test_agent_sends_security_system_and_runtime_contract_as_user_data"]
        },
        {
          "id": "TR-04-R03",
          "level": "MUST",
          "statement": "多轮请求必须使用标准结构化消息，system 与初始合同保持稳定，同一 epoch 内动态状态只追加；继承检查点先归档再替换动态历史。Chat、Messages 与 Responses 使用各自原生字段，未收到终止事件的流不得判为成功。",
          "tests": ["tests.test_llm_streaming.StreamingTests.test_chat_preserves_roles_streams_before_terminal_and_tallies_once", "tests.test_llm_streaming.StreamingTests.test_native_api_dialects_keep_conversation_structured", "tests.test_llm_streaming.StreamingTests.test_missing_terminal_or_responses_incomplete_never_succeeds"]
        },
        {
          "id": "TR-04-R04",
          "level": "MUST",
          "statement": "Agent 状态栏必须作为请求末尾的动态数据追加，从当前任务变量提供进度、工具计数、环境摘要和后台作业快照；不得重写 system 或前缀，也不得继承其他任务的作业。",
          "tests": ["tests.test_runtime_status.RuntimeStatusTests.test_statebar_is_tail_message_data_and_does_not_rewrite_prefix", "tests.test_runtime_status.RuntimeStatusTests.test_snapshot_is_bounded_redacted_and_round_trips", "tests.test_runtime_status.RuntimeStatusTests.test_timeout_cancel_and_session_isolation", "tests.test_runtime_status.RuntimeStatusTests.test_chat_reads_running_job_at_request_tail_then_observes_completion"]
        },
        {
          "id": "TR-04-R05",
          "level": "MUST",
          "statement": "事实和台账必须按差量与周期检查点提供；自动压缩须保留用户约束、事实和最近完整工具链，原历史原子归档后才能替换，失败保持原件，Worker 的差量和压缩状态隔离。",
          "tests": ["tests.test_cache_runtime.CacheRuntimeTests.test_state_delta_contains_only_changed_values_and_periodic_full_checkpoint", "tests.test_cache_runtime.CacheRuntimeTests.test_compaction_archives_original_and_preserves_constraints_facts_and_tool_pairs", "tests.test_cache_runtime.CacheRuntimeTests.test_archive_failure_keeps_original_messages_and_epoch", "tests.test_cache_runtime.CacheRuntimeTests.test_impossible_budget_keeps_latest_request_and_does_not_silently_drop_instructions", "tests.test_cache_runtime.CacheRuntimeTests.test_chat_automatically_compacts_and_keeps_worker_contexts_isolated", "tests.test_cache_runtime.CacheRuntimeTests.test_task_agent_uses_same_compaction_and_persists_diagnostics"]
        },
        {
          "id": "TR-04-R06",
          "level": "MUST",
          "statement": "缓存诊断必须区分可见消息追加、前缀修改、请求条件变化及压缩，未命中输入只用供应商实际总输入与缓存读取求差，不得编造缓存损失归因。",
          "tests": ["tests.test_cache_runtime.CacheRuntimeTests.test_diagnostics_distinguish_growth_rewrite_and_settings_without_inventing_miss_cause", "tests.test_cache_runtime.CacheRuntimeTests.test_deepseek_hit_and_miss_can_supply_total_without_double_counting"]
        }
      ]
    },
