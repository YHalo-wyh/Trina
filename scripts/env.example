# 本地密钥示例 —— 复制到 ~/.trina/env 并填入真实值（**不要提交到仓库**）
#
#   mkdir -p ~/.trina && cp scripts/env.example ~/.trina/env && chmod 600 ~/.trina/env
#   编辑 ~/.trina/env 填入你的 key
#
# 之后用 scripts/dev.sh --api deepseek 即可直连 DeepSeek 官方 API（模型 deepseek-v4-flash）。

# DeepSeek 官方 API（OpenAI 兼容）https://api.deepseek.com/v1
export DEEPSEEK_API_KEY=sk-在此填入你的密钥

# 可选：换用任意 OpenAI 兼容端点（网关/vLLM/自建）
# export PAI_LLM_BASE_URL=https://your-gateway.example.com/v1
# export TRINA_LLM_API_KEY=...
# 可选：默认模型（后端=omp 时生效）
# export TRINA_MODEL=deepseek/deepseek-v4-flash

# 可选：TSecBench 官方访问
# export TRINA_TSECBENCH_KEY=...
